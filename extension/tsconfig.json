{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["chrome", "vite/client"],
    "paths": {
      "@ext/*": ["./src/*"],
      "@renderer/*": ["../src/renderer/src/*"],
      "@shared/*": ["../src/shared/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src", "manifest.config.ts", "vite.config.ts"]
}
